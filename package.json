{
  "name": "yacht-race-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 vite build",
    "build:check": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:native": "NODE_OPTIONS=--max-old-space-size=6144 vite build && cap sync",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "cap:assets": "npx @capacitor/assets generate --ios --android --iconBackgroundColor \"#0b1328\" --iconBackgroundColorDark \"#0b1328\" --splashBackgroundColor \"#0b1328\" --splashBackgroundColorDark \"#0b1328\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@cloudflare/realtimekit": "2.0.4",
    "@cloudflare/realtimekit-recording-sdk": "0.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.39.3",
    "@tiptap/extension-link": "^3.6.6",
    "@tiptap/extension-placeholder": "^3.6.6",
    "@tiptap/react": "^3.6.6",
    "@tiptap/starter-kit": "^3.6.6",
    "@types/jszip": "^3.4.0",
    "@types/qrcode": "^1.5.6",
    "alfie-speech": "file:native/alfie-speech",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.4.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.15",
    "emoji-picker-react": "^4.14.0",
    "flag-icons": "^7.6.0",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.22.3",
    "three": "^0.184.0",
    "uuid": "^9.0.1",
    "workbox-window": "^7.0.0",
    "xlsx": "^0.18.5",
    "yet-another-react-lightbox": "^3.15.6"
  },
